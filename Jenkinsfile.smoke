// Jenkinsfile.smoke -- GHCR publish SMOKE TEST. Pushes a tiny dummy artifact to ghcr and pulls it
// back, to validate the credential + oras + push plumbing BEFORE running the real (multi-hour,
// ~80 GB) build+publish pipeline in the main Jenkinsfile. Point a throwaway Jenkins job at this
// file; if it goes green, the GHCR path (PAT scope, oras, network) works.
//
// Uses the same 'tcp-ci' GHCR PAT credential and account (oosman-tcps) as the real pipeline.

pipeline {
    agent { label 'Win11-Build-Machine' }

    parameters {
        // Empty = a tiny text file (seconds). Set to e.g. 80G to test a large push matching the real
        // OVA -- run this ONLY on a fast, STABLE uplink: oras uploads a blob as ONE non-resumable
        // request, so any network drop restarts the whole upload from zero.
        string(name: 'SMOKE_SIZE', defaultValue: '',
               description: 'Dummy artifact size (e.g. 80G to match the OVA). Empty = tiny file. Big sizes need a fast, stable link.')
    }

    options {
        // A tiny push is seconds; an 80 GB push can be a long haul even on a good link.
        timeout(time: 8, unit: 'HOURS')
    }

    environment {
        GHCR_USER = 'oosman-tcps'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Smoke: publish a dummy artifact to GHCR') {
            steps {
                withCredentials([string(credentialsId: 'tcp-ci', variable: 'GHCR_PAT')]) {
                    sh 'GHCR_USER="${GHCR_USER}" SMOKE_SIZE="${SMOKE_SIZE}" ./smoke-publish.sh'
                }
            }
        }
    }

    post {
        always { cleanWs() }
    }
}
